# Base URL of the Strapi backend (see ../backend).
STRAPI_URL=http://localhost:1337

# Same value as STRAPI_URL, again — server-only env vars are stripped from
# the client bundle, but strapiMediaUrl() (lib/strapi.ts) is also called
# from "use client" components (e.g. inline images inside blog post body
# content), so it needs a NEXT_PUBLIC_-prefixed fallback that's actually
# available there. Keep this in sync with STRAPI_URL by hand.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Optional: API token for the Strapi backend, if the public role's
# permissions aren't sufficient (Settings > API Tokens in the Strapi admin).
# STRAPI_API_TOKEN=

# POST /api/redeploy — triggers a Railway redeploy of this service so that
# Strapi content edits go live (see src/app/api/redeploy/route.ts). Wire
# this up as a Strapi webhook with header `x-redeploy-secret: <secret>`.
REDEPLOY_SECRET=
RAILWAY_TOKEN=
RAILWAY_ACCESS_TOKEN=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
