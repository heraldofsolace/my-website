# Base URL of the Strapi backend (see ../backend).
STRAPI_URL=http://localhost:1337

# Optional: API token for the Strapi backend, if the public role's
# permissions aren't sufficient (Settings > API Tokens in the Strapi admin).
# STRAPI_API_TOKEN=

# POST /api/redeploy — triggers a Railway redeploy of this service so that
# Strapi content edits go live (see src/app/api/redeploy/route.ts). Wire
# this up as a Strapi webhook with header `x-redeploy-secret: <secret>`.
REDEPLOY_SECRET=
RAILWAY_TOKEN=
RAILWAY_ACCESS_TOKEN=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
