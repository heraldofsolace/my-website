HOST=0.0.0.0
PORT=1337

# Generate real values for these — e.g. `openssl rand -base64 32` — never
# reuse the ones from another environment.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# config/database.js reads DATABASE_URL; config/env/development/database.js
# overrides it with DATABASE_PUBLIC_URL in development.
DATABASE_URL=postgres://user:password@localhost:5432/strapi
DATABASE_PUBLIC_URL=postgres://user:password@localhost:5432/strapi
