# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root + every workspace package)
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# nx
.nx/cache
.nx/workspace-data

# testing
coverage

# next.js
.next/
out/

# strapi
backend/.cache
backend/.tmp
backend/build
backend/dist
backend/.strapi

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
